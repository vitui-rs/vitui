# Generated by the `gitlab-runner` module. The token is substituted in on apply; it is not in
# Terraform state and not in git.
concurrent = ${concurrent}
check_interval = 3

[session_server]
  session_timeout = 1800

[[runners]]
  name = "${description}"
  url = "${gitlab_url}"
  # `url` is where the runner talks to GitLab. `clone_url` is what it hands to the *job* container,
  # and they are different addresses for the same instance: a job that clones `localhost` clones
  # itself. This is set explicitly rather than inherited, because inheriting it fails at `git
  # fetch` with a connection refused and nothing upstream of that says why.
  clone_url = "${gitlab_url}"
  token = "__RUNNER_TOKEN__"
  executor = "docker"
  environment = ["FF_NETWORK_PER_BUILD=0"]

  [runners.cache]
    MaxUploadedArchiveSize = 0

  [runners.docker]
    image = "${default_image}"
    # Job containers join the same network as GitLab, so `clone_url`'s hostname resolves.
    network_mode = "${network_name}"
    privileged = false
    # `if-not-present` keeps a local run off the network once the image is here. A CI host that
    # re-pulls `rust:1-bookworm` on every job is measuring the registry, not the code.
    pull_policy = ["if-not-present"]
    shm_size = 268435456
    volumes = ["/cache"]
