# Terragrunt generates the units here from `terragrunt.stack.hcl`. It is output, not source.
.terragrunt-stack/
.terragrunt-cache/

# Local Terraform state. It lives in `live/<location>/<stack>/.state/`, deliberately outside
# `.terragrunt-stack/` — see the `remote_state` block in any unit for why.
.state/
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Credentials: the runner's authentication token and the push token. Deliberately kept out of
# Terraform state as well — see the `gitlab-project` module.
.local/
