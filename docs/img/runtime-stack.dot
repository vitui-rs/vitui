// The vitui stack, as settled by the runtime map (R01-R20). Rendered to runtime-stack.png.
digraph G {
  bgcolor="#12151c" rankdir=TB splines=spline nodesep=0.5 ranksep=0.7 pad=0.4
  fontname="Helvetica Neue"
  node [shape=box style="rounded,filled" fontname="Helvetica Neue" fontsize=17
        penwidth=2.0 margin="0.28,0.20" height=0.75]
  edge [fontname="Helvetica Neue" fontsize=13 color="#5b6472" fontcolor="#939dac"
        penwidth=1.8 arrowsize=0.9]

  subgraph cluster_app {
    label="  APPLICATION  " fontcolor="#6b7585" fontsize=14 color="#2b3040"
    style="rounded" penwidth=1.6 margin=20 labeljust="l"
    app  [label="view(&mut Ctx)\nstate · data · theme registry · tasks"
          fillcolor="#2e2438" color="#8b5fb0" fontcolor="#d9bdf0"]
    react [label="reactivity — outside\nTEA · vitui-signals · plain loop"
           fillcolor="#3a2a20" color="#b07b45" fontcolor="#f0cda0" style="rounded,filled,dashed"]
  }

  subgraph cluster_comp {
    label="  vitui-components — functions only  " fontcolor="#6b7585" fontsize=14 color="#2b3040"
    style="rounded" penwidth=1.6 margin=20 labeljust="l"
    l45 [label="L4·L5   window · modal · select\nchart · form · palette"
         fillcolor="#1e2f28" color="#3f8f6a" fontcolor="#9fe3c0"]
    l23 [label="L2·L3   list · table · tree\npanel · tabs · split"
         fillcolor="#1e2f28" color="#3f8f6a" fontcolor="#9fe3c0"]
    l01 [label="L0·L1   text · fill · border · bar\nplot · input · toggle · scrollbar"
         fillcolor="#1e2f28" color="#3f8f6a" fontcolor="#9fe3c0"]
  }

  subgraph cluster_rt {
    label="  vitui-runtime — no widgets, no reactivity, no tree  "
    fontcolor="#6b7585" fontsize=14 color="#2b3040"
    style="rounded" penwidth=1.6 margin=20 labeljust="l"
    ctx    [label="ctx — the draw context\narea · child · verbs over Paint · caret"
            fillcolor="#2e2438" color="#8b5fb0" fontcolor="#d9bdf0" penwidth=2.6]
    id     [label="id — identity\ncall site + key · never persisted"
            fillcolor="#2e2438" color="#8b5fb0" fontcolor="#d9bdf0"]
    lay    [label="layout + text — rects first\nRect → [Rect] · wrap · width · sizing"
            fillcolor="#2e2438" color="#8b5fb0" fontcolor="#d9bdf0"]
    hit    [label="hit + routing\n312 regions, no geometry · one queue"
            fillcolor="#2e2438" color="#8b5fb0" fontcolor="#d9bdf0"]
    focus  [label="focus + keys\nring · scopes · traps · chords"
            fillcolor="#2e2438" color="#8b5fb0" fontcolor="#d9bdf0"]
    ovl    [label="overlay\nrequests → layers, two-phase · arena"
            fillcolor="#2e2438" color="#8b5fb0" fontcolor="#d9bdf0"]
    data   [label="data + scroll\nRevision · Versioned · Memo · offsets"
            fillcolor="#2e2438" color="#8b5fb0" fontcolor="#d9bdf0"]
    theme  [label="theme + anim\nroles → paints · glyphs · tweens"
            fillcolor="#2e2438" color="#8b5fb0" fontcolor="#d9bdf0"]
    work   [label="work — held by the application\nTask · Slot · Drain · resident Worker"
            fillcolor="#2e2438" color="#8b5fb0" fontcolor="#d9bdf0"]
  }

  subgraph cluster_eng {
    label="  vitui-engine — frozen by ticket 12  " fontcolor="#6b7585" fontsize=14 color="#2b3040"
    style="rounded" penwidth=1.6 margin=20 labeljust="l"
    view   [label="View verbs\ntext · set · fill · restyle · visible_rows"
            fillcolor="#1b2a3f" color="#3d6ea8" fontcolor="#a8cdf5"]
    stack  [label="LayerStack\nadd_content · add_operator · view"
            fillcolor="#1b2a3f" color="#3d6ea8" fontcolor="#a8cdf5"]
    screen [label="Screen\nwait · next_event · present\nset_cursor · set_mouse · request_wake_at"
            fillcolor="#1b2a3f" color="#3d6ea8" fontcolor="#a8cdf5"]
    caps   [label="Capabilities + UCD tables\nrepertoire · colour tier · key tier · segmentation"
            fillcolor="#1b2a3f" color="#3d6ea8" fontcolor="#a8cdf5"]
  }

  app -> l45 [penwidth=2.6 color="#8b5fb0"]
  react -> app [style=dashed label="  re-runs the view"]
  l45 -> l23 [label="  composes"]
  l23 -> l01 [label="  composes"]

  l01 -> ctx [penwidth=2.6 color="#3f8f6a" label="  every layer is\l  fn(&mut Ctx, Rect, ..)\l"]

  ctx -> id     [style=dotted]
  ctx -> hit    [style=dotted]
  ctx -> theme  [style=dotted]
  ctx -> ovl    [style=dotted]
  ctx -> lay    [style=dotted]
  ctx -> data   [style=dotted]
  ctx -> work   [style=invis weight=0]
  id -> focus   [style=dotted label="  names"]
  id -> ovl     [style=dotted label="  owns"]
  hit -> focus  [style=dotted label="  FOCUS bit" constraint=false]
  data -> theme [style=dotted label="  one counter" constraint=false]

  ctx  -> view   [penwidth=2.6 color="#8b5fb0" weight=3]
  ovl  -> stack [weight=4]
  hit  -> screen [label="  tracking level"]
  focus -> screen [label="  caret"]
  theme -> caps
  lay  -> caps   [label="  width tables"]
}
