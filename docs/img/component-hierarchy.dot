digraph G {
  bgcolor="#12151c"
  rankdir=TB
  splines=spline
  nodesep=0.36
  ranksep=0.55
  pad=0.4
  fontname="Helvetica Neue"
  node [shape=box style="rounded,filled" fontname="Helvetica Neue"
        fontsize=17 penwidth=2.0 margin="0.26,0.18" height=0.70]
  edge [fontname="Helvetica Neue" fontsize=12 color="#5b6472"
        fontcolor="#939dac" penwidth=1.7 arrowsize=0.85]

  subgraph cluster_engine {
    label="  ENGINE — the alphabet, settled  "
    fontcolor="#6b7585" fontsize=14 color="#2b3040"
    style="rounded" penwidth=1.6 margin=18 labeljust="l"
    node [fillcolor="#1b2a3f" color="#3d6ea8" fontcolor="#a8cdf5"]
    verbs [label="text · fill · restyle"]
    prim  [label="View · LayerStack\lvisible_rows · set_cursor\l"]
  }

  subgraph cluster_l0 {
    label="  L0 — pure drawers · cells out, no state, no children  "
    fontcolor="#6b7585" fontsize=14 color="#2b3040"
    style="rounded" penwidth=1.6 margin=18 labeljust="l"
    node [fillcolor="#1e2f28" color="#3f8f6a" fontcolor="#9fe3c0"]
    ctext   [label="text"]
    cfill   [label="fill · rule"]
    cbar    [label="bar"]
    cplot   [label="plot\lsub-cell\l"]
    cborder [label="border"]
  }

  subgraph cluster_l1 {
    label="  L1 — one piece of component state  "
    fontcolor="#6b7585" fontsize=14 color="#2b3040"
    style="rounded" penwidth=1.6 margin=18 labeljust="l"
    node [fillcolor="#2e2438" color="#8b5fb0" fontcolor="#d9bdf0"]
    cinput  [label="input"]
    ctoggle [label="toggle"]
    cscroll [label="scrollbar"]
  }

  subgraph cluster_l2 {
    label="  L2 — the only virtualised primitive  "
    fontcolor="#6b7585" fontsize=14 color="#2b3040"
    style="rounded" penwidth=1.6 margin=18 labeljust="l"
    node [fillcolor="#2e2438" color="#8b5fb0" fontcolor="#d9bdf0"]
    clist  [label="list"]
    ctable [label="table\l+ column rects\l"]
    ctree  [label="tree\l+ flattening index\l"]
  }

  subgraph cluster_l3 {
    label="  L3 — containers · run a layout, delegate one at a time  "
    fontcolor="#6b7585" fontsize=14 color="#2b3040"
    style="rounded" penwidth=1.6 margin=18 labeljust="l"
    node [fillcolor="#2e2438" color="#8b5fb0" fontcolor="#d9bdf0"]
    cpanel [label="panel"]
    csplit [label="split · tabs"]
    { rank=same; cpanel; csplit }
  }

  subgraph cluster_l4 {
    label="  L4 — owns a layer · a ROOT, never a child  "
    fontcolor="#6b7585" fontsize=14 color="#2b3040"
    style="rounded" penwidth=1.6 margin=18 labeljust="l"
    node [fillcolor="#22282f" color="#5c6675" fontcolor="#c3ccd8"]
    cwin [label="window · popup · modal\ltwo-phase — E0499\l"]
  }

  subgraph cluster_l5 {
    label="  L5 — compound  "
    fontcolor="#6b7585" fontsize=14 color="#2b3040"
    style="rounded" penwidth=1.6 margin=18 labeljust="l"
    node [fillcolor="#2e2438" color="#8b5fb0" fontcolor="#d9bdf0"]
    cform   [label="form"]
    cchart  [label="chart"]
    cpicker [label="picker"]
  }

  subgraph cluster_not {
    label="  NOT COMPONENTS — never handed a rectangle, never emit a cell  "
    fontcolor="#6b7585" fontsize=14 color="#2b3040"
    style="rounded" penwidth=1.6 margin=18 labeljust="l"
    node [shape=hexagon style="filled" fillcolor="#3a2a20" color="#b07b45"
          fontcolor="#f0cda0" height=0.55 margin="0.30,0.10"]
    layout [label="Layout · Rect → [Rect]\lconsumed by L3 and L2\l"]
    rows   [label="Rows · the data contract\lindexed, shared, N readers\l"]
    style  [label="StyleSource\lgradient lives here\l"]
    ident  [label="Identity — MISSING\lfocus · hit · memo · overlay\l"]
    { rank=same; layout; rows }
    { rank=same; style; ident }
    layout -> style [style=invis]
    rows   -> ident [style=invis]
  }

  verbs -> ctext [penwidth=2.4 color="#3d6ea8"]
  verbs -> cfill [penwidth=2.4 color="#3d6ea8"]
  prim  -> clist [penwidth=2.4 color="#3d6ea8" label="visible window"]

  cfill -> cbar
  cfill -> cplot
  cfill -> cborder

  ctext -> cinput
  cbar  -> cscroll
  cfill -> ctoggle [style=dotted]

  ctree -> cpanel [style=invis]
  clist -> ctable
  clist -> ctree

  cborder -> cpanel
  csplit -> cpanel [style=invis]
  cpanel  -> cwin

  cinput  -> cform
  ctoggle -> cform
  cplot   -> cchart
  clist   -> cpicker
  cwin    -> cpicker [style=dashed label="overlay, next pass"]

  cform -> layout [style=invis]
}
